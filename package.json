{
  "name": "mygrowth-website",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-copy.mjs && node scripts/check-i18n.mjs && node scripts/check-contrast.mjs && node --test \"tests/*.test.ts\"",
    "verify:export": "node scripts/verify-export.mjs",
    "og": "python3 scripts/og/shot.py",
    "prebuild": "node scripts/skyline-data.mjs && node scripts/i18n/gen-index.mjs --strict",
    "predev": "node scripts/skyline-data.mjs && node scripts/i18n/gen-index.mjs",
    "pretypecheck": "node scripts/skyline-data.mjs"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentation": "^3.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^6.0.3"
  }
}
